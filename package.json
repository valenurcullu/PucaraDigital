{
  "name": "pucara-digital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": ">=12.17.0 <13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @pucara/web dev",
    "dev:mobile": "pnpm --filter @pucara/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
